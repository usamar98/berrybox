# Keep real credentials in an ignored .env.local file, never in git.

# Meshy Text to 3D. Server-only: never use a NEXT_PUBLIC_ prefix.
MESHY_API_KEY=
MESHY_TEXT_TO_3D_MODEL=meshy-7

# PostgreSQL from a Vercel Marketplace integration (Neon, Supabase, etc.).
DATABASE_URL=

# Private Vercel Blob store used for generated GLB files and thumbnails.
BLOB_READ_WRITE_TOKEN=

# Vercel sends this as Authorization: Bearer <secret> to the cron route.
CRON_SECRET=

# Conservative server-controlled limits.
MESHY_DAILY_SCENE_QUOTA=3
MESHY_GLOBAL_CONCURRENCY=2
MESHY_WORKER_BATCH_SIZE=2
MESHY_MAX_MODEL_BYTES=100000000
MESHY_MAX_THUMBNAIL_BYTES=8000000

# Reserved for the future structured 3D game pipeline and internal prototype.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BERRYBOX_ENABLE_ALPHA_AI=false
