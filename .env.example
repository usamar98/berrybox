# Keep real credentials in an ignored .env.local file, never in git.
# Enabled product: prompt-to-3D template generation through Meshy.
MESHY_API_KEY=
BERRYBOX_ENABLE_3D_TEMPLATE_GENERATION=false

# Coming-soon providers. Keys can be added to Vercel now, while the product
# status endpoint keeps these features disabled until implementation.
TRIPO_API_KEY=
PEXELS_API_KEY=

# Reserved for the future structured 3D game pipeline and internal prototype.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Production AI is off by default. Enable only behind deployment authentication
# with durable, per-user rate limits and provider spending limits.
BERRYBOX_ENABLE_ALPHA_AI=false
